@using CrashDumpAnalyzer.Utilities
@model IndexPageData
@{
    ViewData["Title"] = "Crash Dump Analyzer";
}


<div class="text-center">
    <div>
        <div class="upload-overview">
            <div>
                <h1 class="display-4 title">@ViewData["Title"]</h1>
                <form id="upload-form" action="/Api/UploadFiles" method="post" enctype="multipart/form-data">
                    <input type="file" class="visually-hidden" name="files" id="files-field" accept="*.dmp;*.dump" multiple />
                    <label for="files-field" id="files-label">Click to choose dump files or drag-n-drop them here</label>
                </form>
                <div class="text-start"><div id="files-progress"></div></div>
                <div class="callstack-search text-start">
                    <form action="/" method="get" class="nosubmit">
                        <div class="d-flex">
                            <input type="text" class="nosubmit" name="searchstring" aria-label="Search callstacks" placeholder="Search... (wildcards * ? supported, start with '/' for regex)" value="@Model.ActiveFilterString" autocomplete='off' />
                            <input type="hidden" name="activeTab" value="@Model.ActiveTab" />
                        </div>
                    </form>
                </div>
            </div>
            <div class="recent-uploads table-responsive" role="region" aria-label="Recently uploaded dumps" tabindex="0">
                <h4>last @Model.UploadedDumps.Count() uploaded dumps</h4>
                <table class="flowTable">
                    <tr>
                        <th>Uploaded</th>
                        <th>Status</th>
                    </tr>
                    @foreach (var item in Model.UploadedDumps)
                    {
                        <tr>
                            <td>@item.UploadDate (@item.UploadDate.AsTimeAgo()), from @item.UploadedFromIp (@item.UploadedFromHostname)</td>
                            @if (item.CallStack.Length == 0 && item.LogSummary.Length == 0)
                            {
                                <td>still analyzing...</td>
                            }
                            else
                            {
                                @if (item.LogSummary.Length == 0)
                                {
                                    <td class="text-center"><a href="/Home/Dump?callstackId=@item.DumpCallstackId">analyzed</a></td>
                                }
                                else
                                {
                                    <td class="text-center"><div data-bs-toggle="tooltip" title="@item.LogSummary">log file analyzed</div></td>
                                }
                            }
                        </tr>
                    }
                </table>
            </div>
        </div>
        <div class="text-end mb-2">
            <button type="button" class="btn btn-primary" aria-label="Delete selected callstacks" title="delete all selected callstacks" onclick="deleteAllSelectedEntries(event.shiftKey)">❌</button>
            <button type="button" class="btn btn-primary" aria-label="Combine selected callstacks" title="combine all selected callstacks" onclick="combineAllSelectedEntries()">⅄</button>
        </div>
        <div>
            @if (Model.Tabs.Count > 1)
            {
                @if (Model.ActiveTab == -1)
                {
                    Model.ActiveTab = 0;
                }
                <ul class="nav nav-tabs">
                    @for (int i = 0; i < Model.Tabs.Count; ++i)
                    {
                        var isActive = Model.ActiveTab == i ? "active" : "";
                        <li class="nav-item">
                            <a class="nav-link @isActive" href="@Url.Action(null, new { activeTab = i, searchstring = Model.ActiveFilterString })">@Model.Tabs[i]</a>
                        </li>
                    }
                </ul>
            }


            <div class="table-responsive crash-list" role="region" aria-label="Crash callstacks" tabindex="0">
            <table class="flowTable">
                <thead>
                    <tr>
                        <th scope="col"><input type="checkbox" id="select-all" aria-label="Select all callstacks" onclick="toggleAllRows(this)" /></th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Callstacks.First().ApplicationName)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Callstacks.First().ApplicationVersion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Callstacks.First().Ticket)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Callstacks.First().FixedVersion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Callstacks.First().ExceptionType)</th>
                        <th scope="col">Dumps</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Callstacks.First().Callstack)</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Callstacks)
                {
                    @if (item.DumpInfos.Count == 0 && item is { Deleted: false, LogFileDatas.Count: 0 })
                        continue;
                    // skip empty dump callstacks
                    {
                        var fixedVersion = new SemanticVersion(item.FixedVersion, item.FixedBuildType < 0 ? BuildTypes.ParseBuildType("") : item.FixedBuildType);
                        var appVersion = new SemanticVersion(item.ApplicationVersion, item.BuildType < 0 ? BuildTypes.ParseBuildType("") : item.BuildType);
                        var isFixed = item.FixedVersion.Length > 0 && appVersion <= fixedVersion;
                        var isNotFixed = item.FixedVersion.Length > 0 && appVersion > fixedVersion;
                        var stateClass = string.Empty;
                        if (isFixed)
                            stateClass = "grid-item-done";
                        else if (isNotFixed)
                            stateClass = "grid-item-notdone";
                        else if (item.Deleted)
                            stateClass = "grid-item-done";

                        string dumpCountInfo = string.Empty;
                        if (item.DumpInfos.Count > 0 && item.LogFileDatas.Count == 0)
                            dumpCountInfo = item.ApplicationName == "Unassigned" ? @item.DumpInfos.Count + " dump" + (@item.DumpInfos.Count == 1 ? "" : "s") : @item.DumpInfos.Count + " dump" + (@item.DumpInfos.Count == 1 ? "" : "s") + ", uploaded " + @item.DumpInfos.Max(dumpInfo => dumpInfo.UploadDate).AsTimeAgo();
                        else if (item.LogFileDatas.Count > 0)
                        {
                            long lineCount = 0;
                            foreach (var data in item.LogFileDatas)
                            {
                                if (data.LineNumbers != null)
                                    lineCount += data.LineNumbers.Count;
                            }
                            dumpCountInfo = @lineCount + " line" + (@lineCount == 1 ? "" : "s");
                            dumpCountInfo += " in " + item.LogFileDatas.Count + " file" + (@item.LogFileDatas.Count == 1 ? "" : "s");
                        }
                        <tr>
                            <td class="text-center align-middle"><input type="checkbox" class="row-checkbox" data-id="@item.DumpCallstackId" aria-label="Select @item.ApplicationName callstack @item.DumpCallstackId" /></td>
                            <!-- application name -->
                            <td class="@stateClass draggable" draggable="true" data-id="@item.DumpCallstackId">
                                @{
                                    var cmdLines = item.DumpInfos
                                    .Where(di => !string.IsNullOrWhiteSpace(di.CommandLine))
                                    .Select(di => di.CommandLine)
                                    .Distinct()
                                    .ToList();
                                    var cmdTooltip = string.Join("\n", cmdLines);
                                }
                                <span data-bs-toggle="tooltip" title="@cmdTooltip">
                                    @Html.DisplayFor(modelItem => item.ApplicationName)
                                </span>
                                <a href="/Home/Dump?callstackId=@item.DumpCallstackId" class="button-link float-end" aria-label="View @item.ApplicationName callstack @item.DumpCallstackId">◎</a>
                            </td>
                            <!-- application version -->
                            <td class="@stateClass">@Html.DisplayFor(modelItem => item.ApplicationVersion) @BuildTypes.BuildTypeString(item.BuildType)</td>
                            <!-- ticket -->
                            <td class="@stateClass">
                                @if (item.Ticket.Length > 0)
                                {
                                    // split item.Ticket into multiple tickets separated by space or comma
                                    var tickets = item.Ticket.Split(new[] { ' ', ',' }, StringSplitOptions.RemoveEmptyEntries);
                                    @foreach (var itemTicket in tickets)
                                    {
                                        @if (Model.IssueData != null && Model.IssueData.ContainsKey(itemTicket))
                                        {
                                            var issue = Model.IssueData[itemTicket];
                                            if (issue != null)
                                            {
                                                var className = "issue-" + @issue.StateColor;
                                                <a href="@Constants.TicketBaseUrl@itemTicket" target="_blank" data-bs-toggle="tooltip" title="@issue.Title" class="ticket">@itemTicket</a>
                                                <div data-bs-toggle="tooltip" title="@issue.Title" class="@className" style="background-color: @issue.StateColor">@issue.State</div>
                                            }
                                        }
                                        else
                                        {
                                            <a href="@Constants.TicketBaseUrl@itemTicket" target="_blank" class="ticket">@itemTicket</a>
                                        }
                                    }
                                }
                                @if (item.ApplicationName != Constants.UnassignedDumpNames)
                                {
                                    <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#setTicketModal" data-id="@item.DumpCallstackId" aria-label="Set ticket for callstack @item.DumpCallstackId">Set</button>
                                }
                            </td>
                            <!-- fixed version -->
                            <td class="@stateClass">
                                <table class="version-table borderless-table">
                                    <tr>
                                        <td class="version-value">
                                            @if (item.FixedVersion.Length > 0)
                                            {
                                                <p class="version">@Html.DisplayFor(modelItem => item.FixedVersion)</p>
                                                <p class="buildType">@BuildTypes.BuildTypeString(item.FixedBuildType)</p>
                                            }
                                        </td>
                                        <td>
                                            @if (item.ApplicationName != Constants.UnassignedDumpNames)
                                            {
                                                <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#setFixedVersionModal" data-id="@item.DumpCallstackId" aria-label="Set fixed version for callstack @item.DumpCallstackId">Set</button>
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <!-- exception type and comment -->
                            <td class="issue-comment-cell @stateClass">
                                @Html.DisplayFor(modelItem => item.ExceptionType)
                                <button type="button" class="btn btn-primary float-end" data-bs-toggle="modal" data-bs-target="#setCommentModal" data-id="@item.DumpCallstackId" aria-label="Edit comment for callstack @item.DumpCallstackId" title="add comment">🗨</button>
                                @{
                                    var comment = item.Comment;
                                    @if (comment.Length > 0)
                                    {
                                        <div class="d-flex flex-column">
                                            <hr />
                                            <p class="comment @stateClass"><a class="comment-preview" role="button" tabindex="0" aria-label="Show comment for callstack @item.DumpCallstackId" data-bs-html="true" data-bs-sanitize="false" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="click" title="Comment" data-bs-content="<span class='comment'>@Html.DisplayFor(modelItem => item.Comment)</span>">@Html.DisplayFor(modelItem => item.Comment)</a></p>
                                        </div>
                                    }
                                }
                            </td>

                            <!-- dump list -->
                            <td class="collapsed @stateClass">
                                @if (item.DumpInfos.Count > 0 && item.LogFileDatas.Count == 0)
                                {
                                    var content = new System.Text.StringBuilder();
                                    var del = 0;
                                    foreach (var dumpInfo in item.DumpInfos)
                                    {
                                        if (dumpInfo.FilePath.Length > 0)
                                        {
                                            content.AppendLine($@"<span><p data-bs-toggle=""tooltip"" title=""{@dumpInfo.DumpTime}""><a href=""/Api/DownloadFile/{@dumpInfo.DumpFileInfoId}"">dump {@dumpInfo.ApplicationVersion} ({@SizeFormatter.SizeSuffix(dumpInfo.FileSize)})</a> Dump from {@dumpInfo.DumpTime.AsTimeAgo()}<button type=""button"" class=""btn btn-primary"" onclick=""deleteDump({@item.DumpCallstackId}, {@dumpInfo.DumpFileInfoId})"" aria-label=""Delete dump file {@dumpInfo.DumpFileInfoId}"" title=""delete dump file"">❌</button></p></span>");
                                        }
                                        else
                                            ++del;
                                    }
                                    if (del > 0)
                                    {
                                        content.AppendLine($"<p>{del} dump files deleted</p>");
                                    }
                                    var contentS = content.ToString();
                                    <a class="dump-file-preview" role="button" tabindex="0" aria-label="Show dump files for callstack @item.DumpCallstackId" data-bs-html="true" data-bs-sanitize="false" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="click" title="Dump file list" data-bs-content='@contentS'>@dumpCountInfo</a>
                                }
                                @if (item.LogFileDatas.Count > 0)
                                {
                                    var content = new System.Text.StringBuilder();
                                    var del = 0;
                                    foreach (var dumpInfo in item.LogFileDatas)
                                    {
                                        if (dumpInfo.DumpFileInfo is { FilePath.Length: > 0 } && dumpInfo.LineNumbers != null)
                                        {
                                            var lnk = @dumpInfo.DumpFileInfo.DumpFileInfoId + "#" + @dumpInfo.LineNumbers[0];
                                            content.AppendLine($@"<span><p data-bs-toggle=""tooltip"" title=""{@dumpInfo.LatestTime}""><a href=""/Api/DownloadFile/{@lnk}"" target=""_blank"">{@dumpInfo.LineNumbers.Count} lines ({@SizeFormatter.SizeSuffix(dumpInfo.DumpFileInfo.FileSize)})</a></p></span>");
                                        }
                                        else
                                            ++del;
                                    }
                                    if (del > 0)
                                    {
                                        content.AppendLine($"<p>{del} entries deleted</p>");
                                    }
                                    var contentS = content.ToString();
                                    <a role="button" tabindex="0" aria-label="Show log files for callstack @item.DumpCallstackId" data-bs-html="true" data-bs-sanitize="false" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="click" title="Dump file list" data-bs-content='@contentS'>@dumpCountInfo</a>
                                }
                            </td>

                            <!-- call stack -->
                            <td class="collapsed callstack @stateClass"><a role="button" tabindex="0" aria-label="Show callstack @item.DumpCallstackId" data-bs-html="true" data-bs-sanitize="false" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="click" title="Callstack" data-bs-content="<span class='callstack'>@Html.DisplayFor(modelItem => item.Callstack)</span>">@Html.DisplayFor(modelItem => item.Callstack)</a></td>
                            <!-- delete and ungroup buttons -->
                            <td class="@stateClass">
                                <button type="button" class="btn btn-primary" onclick="deleteCallstack(@item.DumpCallstackId, event.shiftKey)" aria-label="Delete callstack @item.DumpCallstackId" title="delete callstack">❌</button>
                                @if (item.Callstack.Contains("--------------"))
                                {
                                    <button type="button" class="btn btn-primary" onclick="unlinkCallstack(@item.DumpCallstackId)" aria-label="Ungroup callstack @item.DumpCallstackId" title="ungroup callstacks">🔗</button>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
            </div>


        </div>
    </div>
</div>
<partial name="_CallStackHelpers" />

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
