@using CrashDumpAnalyzer.Utilities
@model CrashDumpAnalyzer.Models.GroupedDumpsData
@{
    ViewData["Title"] = "Grouped Dumps";
}

<div class="text-center">
    <h1 class="display-4 title">@ViewData["Title"]</h1>

    <div class="grouped-weeks-filter">
        <label for="weeksSlider" class="d-block">
            Show dumps from last <span id="weeksValue">@Model.WeeksBack</span> weeks
        </label>
        <input type="range" class="form-range" id="weeksSlider" min="1" max="52" value="@Model.WeeksBack">
    </div>

    <div class="table-responsive" role="region" aria-label="Grouped dumps" tabindex="0">
    <table class="flowTable grouped-dumps-table">
        <thead>
            <tr>
                <th>Group Key</th>
                <th class="group-callstacks-column">Callstacks</th>
                <th class="group-count-column">Dump Count (Last @Model.WeeksBack Weeks)</th>
                <th>Tickets</th>
                <th>Comments</th>
                <th>Fixed Versions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.Groups)
            {
                <tr>
                    <!-- Group Key -->
                    <td>
                        <span>@group.GroupKey</span>
                    </td>

                    <!-- Callstacks -->
                    <td>
                        @foreach (var callstack in group.Callstacks)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <a href="/Home/Dump?callstackId=@callstack.DumpCallstackId" class="button-link" aria-label="View @callstack.ApplicationName callstack @callstack.DumpCallstackId">◎</a>
                                </div>
                            </div>
                        }
                    </td>

                    <!-- Dump Count -->
                    <td class="text-center">
                        <strong>@group.DumpCount</strong>
                    </td>

                    <!-- Tickets -->
                    <td class="group-details-cell">
                        @if (group.Tickets.Count > 0)
                        {
                            foreach (var ticket in group.Tickets)
                            {
                                if (ticket == "(No Ticket)")
                                {
                                    <span>@ticket</span>
                                }
                                else
                                {
                                    CrashDumpAnalyzer.IssueTrackers.Data.IssueData? issue = null;
                                    @if (Model.IssueData != null && Model.IssueData.ContainsKey(ticket))
                                    {
                                        issue = Model.IssueData[ticket];
                                    }
                                    if (issue != null)
                                    {
                                        var className = "issue-" + issue.StateColor;
                                        var ticketUrl = string.IsNullOrEmpty(issue.Url) ? $"{Constants.TicketBaseUrl}{ticket}" : issue.Url;
                                        <a href="@ticketUrl" target="_blank" data-bs-toggle="tooltip" title="@issue.Title" class="ticket">@ticket</a>
                                        <div data-bs-toggle="tooltip" title="@issue.Title" class="@className" style="background-color: @issue.StateColor">@issue.State</div>
                                    }
                                    else
                                    {
                                        <a href="@Constants.TicketBaseUrl@ticket" target="_blank" class="ticket">@ticket</a>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <span class="text-body-secondary">No tickets</span>
                        }
                    </td>

                    <!-- Comments -->
                    <td class="group-details-cell">
                        @{
                            var commentsToShow = group.Callstacks
                                .Where(cs => string.IsNullOrEmpty(cs.Ticket) && !string.IsNullOrEmpty(cs.Comment))
                                .Select(cs => cs.Comment.Trim())
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .ToList();
                        }
                        @if (commentsToShow.Count > 0)
                        {
                            foreach (var comment in commentsToShow)
                            {
                                <div class="group-detail group-comment">
                                    <span>@comment</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-body-secondary">-</span>
                        }
                    </td>

                    <!-- Fixed Versions -->
                    <td class="group-details-cell">
                        @if (group.FixedVersions.Count > 0)
                        {
                            foreach (var version in group.FixedVersions)
                            {
                                <div class="group-detail group-fixed-version">
                                    <span>@version</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-body-secondary">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/grouped-dumps.js" asp-append-version="true"></script>
}
